      "path": "^/[a-z]{1,20}/status/[0-9]{1,20}$",
      "author_from": "page",
      "official": [
        {
          "kind": "oembed",
          "scope": "item",
          "auth": "none",
          "url": "{scheme}://oembed.embed.test{port_suffix}/oembed?url={url_enc}&omit_script=true"
        }
      ],
      "alternates": [],
      "login_hosts": [],
      "terms_note": "fixture",
      "verified_at": null
    },
    {
      "id": "fixture-tube",
      "hosts": [
        "tube.test"
      ],
      "platform_family": "video",
      "path": "^/watch$",
      "author_from": "page",
      "official": [
        {
          "kind": "feed",
          "scope": "all",
          "auth": "user_key",
          "env": "REMORSEARCH_FIXTURE_TUBE_KEY",
          "env_aliases": [
            "REMORSEARCH_FIXTURE_TUBE_OLD_KEY",
            "FIXTURE_TUBE_KEY"
          ],
          "url": "{scheme}://api.tubedata.test{port_suffix}/comments.xml?video={q_v}&key={key}"
        }
      ],
      "alternates": [],
      "login_hosts": [],
      "terms_note": "fixture: a terms_restricted host with an official route",
      "verified_at": null
    },
    {
      "id": "fixture-apitube",
      "hosts": [
        "apitube.test"
      ],
      "platform_family": "video",
      "path": "^/watch$",
      "author_from": "page",
      "official": [
        {
          "kind": "api",
          "doc": "a route kind with no adapter in this version",
          "auth": "user_key",
          "env": "REMORSEARCH_FIXTURE_APITUBE_KEY",
          "url": "{scheme}://api.tubedata.test{port_suffix}/v3/{q_v}?key={key}"
        }
      ],
      "alternates": [],
      "login_hosts": [],
      "terms_note": "fixture: an official route with no adapter",
      "verified_at": null
    }
